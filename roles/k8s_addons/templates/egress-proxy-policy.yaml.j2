{# Kyverno ClusterPolicy: inject a transparent egress-proxy sidecar into pods
   of namespaces labelled <label>=<value>. An init container installs an
   iptables REDIRECT of outbound TCP (all of it, or only include_cidrs) into a
   local port inside the pod netns, minus exclude_cidrs and the sidecar's own
   uid; the sidecar runs gost forwarding captured traffic to the forwarder. #}
{% set fw = k8s_addons_egress_proxy_forwarder %}
{% set lp = k8s_addons_egress_proxy_listen_port %}
{% set uid = k8s_addons_egress_proxy_uid %}
{% set excludes = k8s_addons_egress_proxy_exclude_cidrs %}
{% set includes = k8s_addons_egress_proxy_include_cidrs %}
{% set has_auth = (fw.user | default('') | length) > 0 %}
{% set fw_url = fw.scheme ~ '://' ~ ('${EGRESS_PROXY_USER}:${EGRESS_PROXY_PASS}@' if has_auth else '') ~ fw.host ~ ':' ~ (fw.port | string) %}
{% set exclude_rc = k8s_addons_egress_proxy_exclude_runtime_classes %}
{% set optout_label = k8s_addons_egress_proxy_optout_label %}
apiVersion: "kyverno.io/v1"
kind: "ClusterPolicy"
metadata:
  name: "{{ k8s_addons_egress_proxy_policy_name }}"
  annotations:
    # Evaluate ONLY at Pod admission, not via controller autogen. Autogen
    # rules run against the Deployment/StatefulSet, where the opt-out label
    # (and runtimeClassName) live under spec.template - so a pod-level label
    # selector / precondition wouldn't see them and the opt-out would silently
    # fail. Every pod still goes through Pod admission, so injection coverage
    # is unchanged.
    pod-policies.kyverno.io/autogen-controllers: "none"
spec:
  background: false
  # If Kyverno is unavailable, don't block pod admission in matched
  # namespaces - pods just come up without the sidecar rather than failing.
  failurePolicy: "{{ k8s_addons_egress_proxy_policy_failure_policy }}"
  rules:
    - name: "inject-sidecar"
      match:
        any:
          - resources:
              kinds: ["Pod"]
              namespaceSelector:
                matchLabels:
                  "{{ k8s_addons_egress_proxy_namespace_label }}": "{{ k8s_addons_egress_proxy_namespace_label_value }}"
      # Per-pod opt-out via a native label selector. A pod labelled
      # `{{ optout_label }}: "false"` is skipped - e.g. runAsNonRoot pods that
      # reject the root init, or pods with their own egress policy. Done as an
      # `exclude` selector (not a JMESPath precondition) because reading a pod
      # label through `request.object.metadata.labels."..."` proved unreliable
      # here, whereas a label selector matches natively.
      exclude:
        any:
          - resources:
              kinds: ["Pod"]
              selector:
                matchLabels:
                  "{{ optout_label }}": "false"
      preconditions:
        all:
          # skip pods that already carry the sidecar (idempotency / restarts)
          - key: "egress-proxy-sidecar"
            operator: "AnyNotIn"
            value: "{{ '{{' }} request.object.spec.containers[].name {{ '}}' }}"
          # skip excluded runtime classes - gVisor (runsc) can't do iptables/nft,
          # so the init would fail and the pod would never start. JMESPath string
          # literals are SINGLE-quoted; 'none' is a never-matching sentinel for
          # pods without a runtimeClass (double-quoted "" is a field ref -> null).
          - key: "{{ '{{' }} request.object.spec.runtimeClassName || 'none' {{ '}}' }}"
            operator: "AllNotIn"
            value: [{% for rc in exclude_rc %}"{{ rc }}"{% if not loop.last %}, {% endif %}{% endfor %}]
          # skip pods that require non-root: the init must run as root for
          # iptables, so kubelet rejects it (CreateContainerConfigError) in a
          # pod whose securityContext sets runAsNonRoot: true. Backtick `false`
          # is a JMESPath JSON literal so the compare stays boolean-typed.
          - key: "{{ '{{' }} request.object.spec.securityContext.runAsNonRoot || `false` {{ '}}' }}"
            operator: "Equals"
            value: false
      mutate:
        patchStrategicMerge:
          spec:
            initContainers:
              - name: "egress-proxy-init"
                image: "{{ k8s_addons_egress_proxy_init_image }}"
                imagePullPolicy: "IfNotPresent"
                securityContext:
                  # The init needs root for iptables. Pods that enforce
                  # pod-level runAsNonRoot therefore can't take this init
                  # (kubelet rejects the root container, and Kyverno's
                  # patchStrategicMerge drops a container-level `runAsNonRoot:
                  # false` override) - opt those pods out via
                  # `{{ optout_label }}: "false"`.
                  runAsUser: 0
                  capabilities:
                    add: ["NET_ADMIN", "NET_RAW"]
                command: ["sh", "-c"]
                args:
                  - |
                    set -e
                    iptables -t nat -N EGRESS_PROXY 2>/dev/null || true
{% for cidr in excludes %}
                    iptables -t nat -C EGRESS_PROXY -d {{ cidr }} -j RETURN 2>/dev/null || iptables -t nat -A EGRESS_PROXY -d {{ cidr }} -j RETURN
{% endfor %}
{% if includes | length > 0 %}
{% for cidr in includes %}
                    iptables -t nat -C EGRESS_PROXY -d {{ cidr }} -p tcp -j REDIRECT --to-ports {{ lp }} 2>/dev/null || iptables -t nat -A EGRESS_PROXY -d {{ cidr }} -p tcp -j REDIRECT --to-ports {{ lp }}
{% endfor %}
{% else %}
                    iptables -t nat -C EGRESS_PROXY -p tcp -j REDIRECT --to-ports {{ lp }} 2>/dev/null || iptables -t nat -A EGRESS_PROXY -p tcp -j REDIRECT --to-ports {{ lp }}
{% endif %}
                    # exclude the sidecar's own traffic (its forwarder uplink), then hook OUTPUT
                    iptables -t nat -C OUTPUT -m owner --uid-owner {{ uid }} -j RETURN 2>/dev/null || iptables -t nat -A OUTPUT -m owner --uid-owner {{ uid }} -j RETURN
                    iptables -t nat -C OUTPUT -p tcp -j EGRESS_PROXY 2>/dev/null || iptables -t nat -A OUTPUT -p tcp -j EGRESS_PROXY
              # native sidecar: starts before app containers and stays running
              - name: "egress-proxy-sidecar"
                image: "{{ k8s_addons_egress_proxy_sidecar_image }}"
                imagePullPolicy: "IfNotPresent"
                restartPolicy: "Always"
                securityContext:
                  runAsUser: {{ uid }}
                # shell-expanded ${VAR} (not k8s $(VAR)) so Kyverno's policy
                # validator leaves it alone and the creds stay in the Secret.
                command: ["/bin/sh", "-c"]
                args:
                  - 'exec /bin/gost -L "redir://:{{ lp }}" -F "{{ fw_url }}"'
{% if has_auth %}
                env:
                  - name: "EGRESS_PROXY_USER"
                    valueFrom:
                      secretKeyRef:
                        name: "{{ k8s_addons_egress_proxy_secret_name }}"
                        key: "user"
                  - name: "EGRESS_PROXY_PASS"
                    valueFrom:
                      secretKeyRef:
                        name: "{{ k8s_addons_egress_proxy_secret_name }}"
                        key: "pass"
{% endif %}
