{{ define "telegram.instance_emojis" }}
{{- $alerts := . }}
[% for name, emoji in alertmanager_instance_emojis.items() %]
{{- $hit := false }}{{ range $alerts }}{{ if eq .Labels.instance_name [[ name | to_json ]] }}{{ $hit = true }}{{ end }}{{ end }}
{{- if $hit }}[[ emoji ]]{{ end }}
[% endfor %]
{{- end }}

{{/* One instance_name or observer label value: its emoji, or the value itself without one. */}}
{{ define "telegram.instance_emoji" }}
{{- $name := . }}{{ $hit := false }}
[% for name, emoji in alertmanager_instance_emojis.items() %]
{{- if eq $name [[ name | to_json ]] }}[[ emoji ]]{{ $hit = true }}{{ end }}
[% endfor %]
{{- if not $hit }}{{ $name }}{{ end }}
{{- end }}
