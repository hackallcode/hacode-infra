{{ define "telegram.default.message" }}
{{- if .Alerts.Firing }}{{ template "telegram.alerts" .Alerts.Firing }}{{ end }}
{{- if and .Alerts.Firing .Alerts.Resolved }}

{{ end }}
{{- if .Alerts.Resolved }}{{ template "telegram.alerts" .Alerts.Resolved }}{{ end }}
{{- end }}

{{ define "telegram.alerts" }}
{{- $first := index . 0 }}
{{- $severity := $first.Labels.severity }}
{{- $category := or $first.Labels.category "alert" }}
{{- if eq $first.Status "resolved" }}&#9989;
{{- else if eq $severity "critical" }}&#128680;
{{- else if eq $severity "warning" }}&#9888;&#65039;
{{- else }}&#8505;&#65039;
{{- end }}
{{- template "telegram.instance_emojis" . }}
{{- if eq $category "memory" }}&#129504;
{{- else if eq $category "cpu" }}&#9881;&#65039;
{{- else if eq $category "disk" }}&#128190;
{{- else if eq $category "network" }}&#127760;
{{- else if eq $category "host" }}&#128421;&#65039;
{{- else if eq $category "clock" }}&#128336;
{{- else if eq $category "services" }}&#129520;
{{- else if eq $category "mesh" }}&#128376;&#65039;
{{- else if eq $category "monitoring" }}&#128225;
{{- else }}&#128276;
{{- end }}
{{- $longest := 0.0 }}
{{- range . }}
{{- $d := (.EndsAt.Sub .StartsAt).Seconds }}
{{- if eq .Status "firing" }}{{ $d = (since .StartsAt).Seconds }}{{ end }}
{{- if gt $d $longest }}{{ $longest = $d }}{{ end }}
{{- end }} <b>{{ title $severity }} &#8226; {{ title $category }} &#8226;
{{- if eq $first.Status "resolved" }} Resolved in {{ else }} Firing {{ end }}{{ $longest | humanizeDuration }}</b>
{{ range . }}
{{ or .Annotations.description .Annotations.summary }}
{{- end }}
{{- end }}
