{{ define "telegram.default.message" }}
{{- if .Alerts.Firing }}{{ template "telegram.alerts" .Alerts.Firing }}{{ end }}
{{- if and .Alerts.Firing .Alerts.Resolved }}

{{ end }}
{{- if .Alerts.Resolved }}{{ template "telegram.alerts" .Alerts.Resolved }}{{ end }}
{{- end }}

{{ define "telegram.alerts" }}
{{- $first := index . 0 }}
{{- $severity := or $first.Labels.severity "info" }}
{{- $category := or $first.Labels.category "alert" }}
{{- if eq $first.Status "resolved" }}&#9989;
{{- else if eq $severity "critical" }}&#128680;
{{- else if eq $severity "warning" }}&#9888;&#65039;
{{- else }}&#8505;&#65039;
{{- end }}
{{- template "telegram.instance_emojis" . }}
{{- if eq $category "memory" }}&#129504;
{{- else if eq $category "cpu" }}&#9881;&#65039;
{{- else if eq $category "disk" }}&#128190;
{{- else if eq $category "network" }}&#127760;
{{- else if eq $category "host" }}&#128421;&#65039;
{{- else if eq $category "clock" }}&#128336;
{{- else if eq $category "services" }}&#129520;
{{- else if eq $category "mesh" }}&#128376;&#65039;
{{- else if eq $category "monitoring" }}&#128225;
{{- else }}&#128276;
{{- end }}
{{- " " }}<b>{{ title $severity }} &#8226; {{ title $category }} &#8226;
{{- if eq $first.Status "resolved" }} Resolved{{ else }} Firing{{ end }}</b>
{{ range . }}
{{- /* A group is notified once its alert set changes, within group_interval: an alert fired under a
minute ago is the one that changed it. Times are in the Alertmanager host's time zone. */}}
{{- $format := "15:04" }}
{{- if gt (since .StartsAt).Hours 20.0 }}{{ $format = "02.01 15:04" }}{{ end }}
{{- $start := .StartsAt.Local.Format $format }}
{{- $end := .EndsAt.Local.Format $format }}
{{- $age := (since .StartsAt).Truncate 1000000000 }}
{{- $lasted := (.EndsAt.Sub .StartsAt).Truncate 1000000000 }}
{{ if and (eq .Status "firing") (lt $age.Seconds 60.0) }}&#127381; {{ end }}
{{- or .Annotations.description .Annotations.summary }}
{{- if eq .Status "firing" }} <i>since {{ $start }}, {{ $age.Seconds | humanizeDuration }}</i>
{{- else }} <i>{{ $start }}{{ if ne $start $end }}&#8211;{{ $end }}{{ end }}, {{ $lasted.Seconds | humanizeDuration }}</i>
{{- end }}
{{- end }}
{{- end }}
