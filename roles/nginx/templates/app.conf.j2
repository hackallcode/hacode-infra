server {
    listen 80;
    listen [::]:80;

    {% include 'nginx-parts/http-header.conf.j2' %}

    {% include 'nginx-parts/alias-redirect.conf.j2' %}

    include /etc/nginx/default.d/redirect-to-https.conf;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    {% include 'nginx-parts/https-header.conf.j2' %}

    {% include 'nginx-parts/alias-redirect.conf.j2' %}

    # Static server
    include /etc/nginx/default.d/static.conf;

