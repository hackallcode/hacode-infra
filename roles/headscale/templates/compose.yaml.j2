{% set oidc_wait = headscale_oidc and headscale_oidc_wait | int > 0 %}
services:
{% if oidc_wait %}
  oidc-wait:
    image: "{{ headscale_oidc_wait_image }}"
    network_mode: "host"
    entrypoint: ["sh", "-c"]
    command:
      - >-
        curl -fsS -o /dev/null --connect-timeout 5 --max-time 10
        --retry 1000 --retry-delay 5 --retry-all-errors --retry-max-time {{ headscale_oidc_wait | int }}
        '{{ headscale_oidc.issuer | regex_replace('/$', '') }}/.well-known/openid-configuration'
        || echo "the OIDC provider is down: headscale starts with CLI login only"
    restart: "no"
{% endif %}
  headscale:
    image: "{{ headscale_image }}"
    container_name: "headscale"
    command: ["serve"]
    network_mode: "host"
    volumes:
      - "./config/:/etc/headscale/:ro"
      - "./data/:/var/lib/headscale/"
    restart: "unless-stopped"
{% if oidc_wait %}
    depends_on:
      oidc-wait:
        condition: "service_completed_successfully"
{% endif %}
