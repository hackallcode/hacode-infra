[Unit]
Description=failover agent for %i
After=network-online.target docker.service nats.service tailscaled.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
Environment=PYTHONUNBUFFERED=1
ExecStart={{ _failover_bin }} run {{ failover_config_dir }}/%i.json
# The service's containers outlive the agent and must not write without its lease.
ExecStopPost={{ _failover_bin }} stop {{ failover_config_dir }}/%i.json
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
