roles/maria_db/tasks/delete-user.yml fqcn[canonical]
roles/maria_db/tasks/restore-db.yml fqcn[canonical]
roles/maria_db/tasks/install.yml fqcn[canonical]
extensions/molecule/maria_db/verify.yml fqcn[canonical]
